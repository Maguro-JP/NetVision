# 客先ごとの設定の見本。
#
# 使い方: このファイルを config/<客先名>.env としてコピーし、必要な行だけ残して
# 書き換えます。起動するときに、どのファイルを読むかを渡します。
#
#   NETVISION_ENV_FILE=config/aomori.env python -m uvicorn app.main:app
#
# 共通の既定は backend/.env に置いたままにして、ここには「その現場だけの違い」
# だけを書きます。混ぜると、どれが現場の都合なのか後から分からなくなります。
# 実際の値の入ったファイルは Git に入れません（管理IP や鍵が入るため）。

# --- 置き場所 ---
# NETVISION_DATABASE_URL=postgresql+psycopg://netvision:netvision@localhost:5432/netvision
# NETVISION_DOCUMENT_STORAGE_PATH=./data/documents
# NETVISION_BACKUP_PATH=./data/backups

# --- 期限の見せ方 ---
# 保守期限まで何日で色を変えるか。現場の調達の速さに合わせます
# NETVISION_WARNING_DAYS=365
# NETVISION_CRITICAL_DAYS=90
# リファレンスがこの日数より古ければ「情報が古い」と出します
# NETVISION_REFERENCE_STALE_DAYS=180

# --- 見せ方 ---
# NETVISION_DISPLAY_TIMEZONE=Asia/Tokyo
# 画面も同じプロセスから配る（1台完結）
# NETVISION_SERVE_FRONTEND=../frontend/dist

# --- 取り込みの上限 ---
# 16万行規模の Excel を扱う現場では上げます
# NETVISION_MAX_IMPORT_BYTES=536870912

# --- モデル ---
# 閉域の中に立てたモデルだけを指します。空なら規則ベースだけで動きます
# NETVISION_LLM_URL=http://127.0.0.1:11434/v1
# NETVISION_LLM_MODEL=qwen2.5-coder:7b
# 役割で分ける場合（こちらが優先）
# NETVISION_LLM_PROFILES=[{"role":"quick","url":"http://127.0.0.1:11434/v1","model":"qwen2.5:3b"},{"role":"deep","url":"http://127.0.0.1:11434/v1","model":"qwen2.5-coder:14b"}]
# 外の事業者の API を使う場合だけ真にします。既定は不可
# NETVISION_LLM_ALLOW_EXTERNAL=false
# NETVISION_LLM_API_KEY=

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/lang-rule.sh"
          },
          {
            "type": "command",
            "command": "cat .claude/skills/work-style/SKILL.md 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": ".claude/hooks/lessons.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/finish-first/hooks/focus.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/lang-rule.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/skill-nudge.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/token-efficiency/hooks/efficiency_core.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/follow-instructions/hooks/directives.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/prompt-from-context/hooks/brief.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/finish-first/hooks/focus.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/lang-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".claude/skills/feedback-session/scripts/gate.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": ".claude/hooks/test.sh",
            "timeout": 600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/token-efficiency/hooks/session_report.py",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/verify-before-done/hooks/done_check.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pr-nudge.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/token-efficiency/hooks/trajectory_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/desktop-app/hooks/no_browser.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/skills/follow-instructions/hooks/no_self_grant.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
